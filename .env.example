# GrowthifyEdge HRMS — frontend environment variables
# All variables here are safe for browser exposure (VITE_ prefix).
# Copy to .env and fill in values from your Supabase project settings.

# Supabase project URL (Project Settings -> API -> Project URL)
VITE_SUPABASE_URL=

# Supabase publishable (anon) key (Project Settings -> API -> anon/public key).
# This key is safe in the browser: all access is enforced by Row-Level Security.
VITE_SUPABASE_PUBLISHABLE_KEY=

# development | preview | production
VITE_APP_ENV=development

# The URL the app is served from (used for auth redirects)
VITE_APP_URL=http://localhost:5173

# NEVER put any of the following in frontend env files:
# SUPABASE_SERVICE_ROLE_KEY, SUPABASE_SECRET_KEY, DATABASE_PASSWORD, CLOUDFLARE_API_TOKEN
